         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Set of four bottles of wine with glasses and snacks. Handmade picture in line style. Black contour with colored spots. Isolated on white background.  Vector flat illustration. Template for menu design</rdf:li>
            </rdf:Alt>
         </dc:description>
